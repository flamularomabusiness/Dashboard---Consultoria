# Copie este arquivo para .env.local e preencha os valores.
# Sem essas variáveis, o dashboard roda inteiramente com dados fictícios (lib/mock-data.ts).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Sheets — link de exportação CSV da planilha de clientes.
# Na planilha: Arquivo > Compartilhar > Publicar na web (ou deixe "Qualquer
# pessoa com o link pode visualizar") e monte a URL abaixo com o ID da
# planilha e o gid da aba desejada:
#   https://docs.google.com/spreadsheets/d/<ID_DA_PLANILHA>/export?format=csv&gid=<GID_DA_ABA>
# Colunas esperadas (com cabeçalho): cliente_nome, consultora_id
GOOGLE_SHEETS_EXPORT_URL=
