# Copie este arquivo para .env.local e preencha os valores.
# Sem essas variáveis, o dashboard roda inteiramente com dados fictícios (lib/mock-data.ts).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Sheets — link de exportação CSV da planilha de clientes e agendamentos fixos.
# Na planilha: Arquivo > Compartilhar > Publicar na web (ou deixe "Qualquer
# pessoa com o link pode visualizar") e monte a URL abaixo com o ID da
# planilha e o gid da aba desejada:
#   https://docs.google.com/spreadsheets/d/<ID_DA_PLANILHA>/export?format=csv&gid=<GID_DA_ABA>
#
# Mesma planilha/URL usada por lib/google-sheets.ts para duas coisas:
#   - fetchClientes(): lê cliente_nome, consultora_id
#   - fetchAgendamentosFixos(): lê cliente_nome, consultora_id, dia_semana, horario
#     (dia_semana/horario podem ficar em branco para um cliente sem horário fixo)
# Colunas esperadas (com cabeçalho): cliente_nome, consultora_id, dia_semana, horario
GOOGLE_SHEETS_EXPORT_URL=
